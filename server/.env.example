# Server Port and Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_library?retryWrites=true&w=majority

# JWT Authentication Secret and Token Expiry
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_EXPIRE=7d

# Allowed Frontend Origins (comma-separated if multiple)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Timezone for scheduled due-date notifications and date formatting
TIMEZONE=Asia/Kolkata

# Node Cron Schedule Pattern (default: once every hour at minute 0)
CRON_SCHEDULE=0 * * * *

# Library Rules
MAX_BORROW_LIMIT=3
FINE_PER_DAY=0
ALLOW_STUDENT_REGISTRATION=true

# Optional Nodemailer SMTP Configuration for Email Reminders
# Leave blank to use in-app notifications only
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Library" <noreply@smartlibrary.edu>

